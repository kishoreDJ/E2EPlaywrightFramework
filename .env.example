# =============================================================================
# .env.example
# Copy this file to .env and fill in values for local development.
# Never commit .env to source control.
#
# CLASSIFICATION KEY
# ------------------
# [repo secret]   → GitHub Actions: Settings > Secrets and variables > Actions > Secrets
#                   Encrypted at rest; never exposed in logs.
# [repo variable] → GitHub Actions: Settings > Secrets and variables > Actions > Variables
#                   Plain text; safe for non-sensitive config.
# [env secret]    → GitHub Actions Environment secrets (e.g. staging / production env)
#                   Scoped to a deployment environment; requires env approval gate.
# [env variable]  → GitHub Actions Environment variables
#                   Plain text config scoped to a deployment environment.
# [local only]    → Not used in CI; only relevant for local development runs.
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION BASE URLs
# -----------------------------------------------------------------------------

# Main REST API under test.                                     [repo secret]
API_BASE_URL=

# DJCSS (Dow Jones Customer Support Site) web app URL.          [env secret]  (staging environment)
DJCSS_BASE_URL=

# CDPR batches service API URL.                                 [repo secret]
BATCHES_BASE_URL=

# Alfresco CMS base URL.                                        [repo secret]
ALFRESCO_BASE_URL=

# UAP (User Administration Platform) API URL.                   [repo secret]
UAP_BASE_URL=


# -----------------------------------------------------------------------------
# DJCSS WEB APP CREDENTIALS
# Used by browser-driven Playwright tests to log into DJCSS.
# -----------------------------------------------------------------------------

# DJCSS login username.                                         [env secret]  (staging environment)
DJCSS_USERNAME=

# DJCSS login password.                                         [env secret]  (staging environment)
DJCSS_PASSWORD=


# -----------------------------------------------------------------------------
# ALFRESCO CMS CREDENTIALS
# Used by tests that interact with the Alfresco content management system.
# -----------------------------------------------------------------------------

# Alfresco login username.                                      [repo secret]
ALFRESCO_USERNAME=

# Alfresco login password.                                      [repo secret]
ALFRESCO_PASSWORD=


# -----------------------------------------------------------------------------
# OAUTH — PRIMARY (DJCSS / Mosaic API)
# Used by authHelper.ts to obtain bearer tokens for the main API.
# -----------------------------------------------------------------------------

# Token endpoint URL.                                           [repo secret]
OAUTH_TOKEN_URL=

# OAuth client ID.                                              [repo secret]
OAUTH_CLIENT_ID=

# OAuth client secret.                                          [repo secret]
OAUTH_CLIENT_SECRET=

# OAuth scope (space-separated list of scopes).                 [local only]
OAUTH_SCOPE=


# -----------------------------------------------------------------------------
# OAUTH — BATCHES SERVICE (CDPR)
# Used by authHelper.ts to obtain tokens for the CDPR batches API.
# -----------------------------------------------------------------------------

# Token endpoint URL for batches service OAuth.                 [repo secret]
BATCHES_OAUTH_TOKEN_URL=

# Client ID for batches service OAuth.                          [repo secret]
BATCHES_OAUTH_CLIENT_ID=

# Client secret for batches service OAuth.                      [repo secret]
BATCHES_OAUTH_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# OAUTH — UAP (User Administration Platform)
# Used by uapHelper.ts to obtain tokens for UAP API calls.
# -----------------------------------------------------------------------------

# Token endpoint URL for UAP OAuth.                             [repo secret]
UAP_OAUTH_TOKEN_URL=

# Client ID for UAP OAuth.                                      [repo secret]
UAP_OAUTH_CLIENT_ID=

# Client secret for UAP OAuth.                                  [repo secret]
UAP_OAUTH_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# DATABASE CONNECTIONS
# Connection strings for direct DB access in helpers and query scripts.
# Format: postgresql://user:password@host:port/dbname
# -----------------------------------------------------------------------------

# Primary application database connection string.               [repo secret]
DATABASE_URL=

# CSM (Customer Service Manager) database connection string.    [repo secret]
CSM_DATABASE_URL=


# -----------------------------------------------------------------------------
# AI / AWS BEDROCK AGENT
# Used by dbAgent.ts to power the natural-language DB query helper.
# -----------------------------------------------------------------------------

# API key for the AWS Bedrock LLM endpoint.                     [repo secret]
BEDROCK_API_KEY=

# Base URL for the AWS Bedrock API endpoint.                    [repo secret]
BEDROCK_BASE_URL=


# -----------------------------------------------------------------------------
# BROWSERSTACK
# Required when USE_BROWSERSTACK=true. Credentials from BrowserStack Automate.
# -----------------------------------------------------------------------------

# Route tests to BrowserStack Automate. Set to true to enable.  [repo variable]
# Options: true | false
USE_BROWSERSTACK=

# Enable BrowserStack Local tunnel for QA/dev URL access.       [repo variable]
# Set to true when DJCSS_BASE_URL is a local or internal URL not reachable
# from the public internet (e.g. https://qa.internal.company.com).
USE_BS_LOCAL=

# BrowserStack account username.                                 [repo secret]
BROWSERSTACK_USERNAME=

# BrowserStack account access key.                              [repo secret]
BROWSERSTACK_ACCESS_KEY=

# Build label shown in the BrowserStack Automate dashboard.     [repo variable]
# Auto-set by CI to commit SHA or PR number; override locally as needed.
BS_BUILD_NAME=

# Project name shown in the BrowserStack Automate dashboard.    [repo variable]
BS_PROJECT_NAME=

# OS/browser preset to use for BrowserStack runs.               [repo variable]
# Options: chrome-windows-11 | chrome-mac-sequoia | firefox-windows-11 | edge-windows-11
BS_CAPABILITY_PRESET=

# Unique identifier for the BrowserStack Local tunnel instance.  [repo variable]
# In CI this is set to github.run_id so parallel jobs don't share tunnels.
# Locally keep as 'default' unless you run multiple tunnels simultaneously.
BS_LOCAL_IDENTIFIER=default


# -----------------------------------------------------------------------------
# PLAYWRIGHT / TEST RUNNER CONFIG
# Controls how Playwright runs tests locally and in CI.
# -----------------------------------------------------------------------------

# Target environment label written into the Allure report.      [repo variable]
# Examples: dev | staging | production
TEST_ENV=

# Set to false to run browsers in headed (visible) mode.        [local only]
# Uncomment to use.
#HEADLESS=false

# Override the number of parallel Playwright worker processes.  [local only]
WORKERS=

# Browser name written into the Allure environment properties.  [local only]
# Defaults to chromium if unset.
BROWSER=

# Enable Node.js / Playwright debug output.                     [local only]
DEBUG=


# -----------------------------------------------------------------------------
# HTTP REQUEST HEADERS
# Injected into API requests to identify the test framework as the caller.
# -----------------------------------------------------------------------------

# Value for the origin-application-name request header.        [local only]
# Defaults to TestFramework if unset.
ORIGIN_APP_NAME=

# Value for the source-application-name request header.        [local only]
# Defaults to TestFramework if unset.
SOURCE_APP_NAME=


# -----------------------------------------------------------------------------
# ALLURE REPORTING
# Controls where Allure writes results and how the report is branded.
# -----------------------------------------------------------------------------

# Output directory for raw Allure JSON results.                 [local only]
# Defaults to allure-results if unset.
ALLURE_RESULTS_DIR=

# Directory where the rendered Allure HTML report is written.   [local only]
# Defaults to allure-report if unset.
ALLURE_REPORT_DIR=

# Application name used to brand the Allure report header.     [repo variable]
APP_NAME=

# CI build URL written into the Allure executor block.          [env variable]
# Typically auto-populated by GitHub Actions (${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}).
BUILD_URL=

# CI build number written into the Allure executor block.       [env variable]
# Typically auto-populated by GitHub Actions (${{ github.run_number }}).
BUILD_NUMBER=

# Display name for the executor shown in the Allure report.     [env variable]
# Defaults to "Local Run" if unset.
EXECUTOR_NAME=


# -----------------------------------------------------------------------------
# REPORT DEPLOYMENT
# Used by scripts/report-deploy.js to publish the Allure report to a repo.
# -----------------------------------------------------------------------------

# Source path of the generated Allure report to deploy.         [env variable]
REPORT_SOURCE=

# Target repository path where the report is published.         [env variable]
REPORT_REPO_PATH=

# Number of days of historical reports to retain.               [env variable]
# Defaults to 90 if unset.
REPORT_RETENTION_DAYS=

# Test suite label used in report deployment.                   [env variable]
# Examples: Smoke | Regression | Full
SUITE=


# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

# Controls logger verbosity.                                    [local only]
# Options: debug | info | warn | error  (defaults to info)
LOG_LEVEL=
