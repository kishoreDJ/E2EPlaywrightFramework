API_BASE_URL=
DJCSS_BASE_URL=
TEST_ENV=
DEBUG=
#HEADLESS=false

# ---- BrowserStack ----
# Set USE_BROWSERSTACK=false to route tests to BrowserStack Automate
USE_BROWSERSTACK=

# Build label shown in the BS Automate dashboard (auto-set by CI to the commit SHA or PR number)
BS_BUILD_NAME=
BS_PROJECT_NAME=
# Key from BS_CAPABILITY_PRESETS in browserstack-config.ts
# Options: chrome-windows-11 | chrome-mac-sequoia | firefox-windows-11 | edge-windows-11
BS_CAPABILITY_PRESET=c
DJCSS_USERNAME=
DJCSS_PASSWORD=
ALFRESCO_BASE_URL=
ALFRESCO_USERNAME=
ALFRESCO_PASSWORD=
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=